rules_version = '2';

// Every user can only read and write documents under their own
// users/{uid}/... subtree. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // Keep these lists in sync with src/constants/word.ts.
    function wordTypes() {
      return ['noun', 'verb', 'adjective', 'adverb', 'pronoun', 'preposition',
              'conjunction', 'interjection', 'phrase'];
    }

    function articles() {
      return ['un', 'una', 'el', 'la', 'not_used'];
    }

    // Keep in sync with src/constants/conjugation.ts (TENSE_CONFIG and PERSONS).
    function tenses() {
      return ['present', 'preterite', 'imperfect', 'conditional', 'future', 'imperative'];
    }

    function persons() {
      return ['yo', 'tu', 'el', 'nosotros', 'vosotros', 'ellos'];
    }

    function isForm(value) {
      return value is string && value.size() <= 300;
    }

    // conjugations[tense][person] = string
    function isValidTense(m) {
      return m is map && m.keys().hasOnly(persons())
        && (!('yo' in m) || isForm(m.yo))
        && (!('tu' in m) || isForm(m.tu))
        && (!('el' in m) || isForm(m.el))
        && (!('nosotros' in m) || isForm(m.nosotros))
        && (!('vosotros' in m) || isForm(m.vosotros))
        && (!('ellos' in m) || isForm(m.ellos));
    }

    function isValidConjugations(c) {
      return c is map && c.keys().hasOnly(tenses())
        && (!('present' in c) || isValidTense(c.present))
        && (!('preterite' in c) || isValidTense(c.preterite))
        && (!('imperfect' in c) || isValidTense(c.imperfect))
        && (!('conditional' in c) || isValidTense(c.conditional))
        && (!('future' in c) || isValidTense(c.future))
        && (!('imperative' in c) || isValidTense(c.imperative));
    }

    // Optional fields may be absent ("not filled in") but must be valid when present.
    function isValidWord(data) {
      return isShortString(data.spanish, 300)
        && data.english is string && data.english.size() <= 300 // may be empty (drafts)
        && (!('type' in data) || data.type in wordTypes())
        && (!('article' in data) || data.article in articles())
        && (!('plural' in data) || (data.plural is string && data.plural.size() <= 300))
        && (!('conjugations' in data) || isValidConjugations(data.conjugations))
        && (!('gerund' in data) || isForm(data.gerund))
        && data.schemaVersion is int
        && data.easeFactor is number
        && data.interval is number
        && data.repetitions is int
        && data.nextReviewDate is int
        && data.createdAt is int;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /words/{wordId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidWord(request.resource.data);
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      match /dailyStats/{day} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything that is not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
