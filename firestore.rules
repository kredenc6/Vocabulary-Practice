rules_version = '2';

// Every user can only read and write documents under their own
// users/{uid}/... subtree. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // Keep these lists in sync with src/constants/word.ts.
    function wordTypes() {
      return ['noun', 'verb', 'adjective', 'adverb', 'pronoun', 'preposition',
              'conjunction', 'interjection', 'phrase'];
    }

    function articles() {
      return ['un', 'una', 'el', 'la', 'not_used'];
    }

    // Conjugations – mirrors CONJUGATION_GROUPS in src/constants/conjugation.ts.
    // Shape: conjugations[group][tense][person] (persons groups) or conjugations[group][form].
    // Adding a group: add its key to the hasOnly() list below plus one isValid_<group>() function.
    function isForm(value) {
      return value is string && value.size() <= 300;
    }

    function isValidTense(m) {
      return m is map && m.keys().hasOnly(['yo', 'tu', 'el', 'nosotros', 'vosotros', 'ellos'])
        && isForm(m.get('yo', ''))
        && isForm(m.get('tu', ''))
        && isForm(m.get('el', ''))
        && isForm(m.get('nosotros', ''))
        && isForm(m.get('vosotros', ''))
        && isForm(m.get('ellos', ''));
    }

    function isValid_indicative(g) {
      return g is map && g.keys().hasOnly(['present', 'preterite', 'imperfect', 'conditional', 'future'])
        && isValidTense(g.get('present', {}))
        && isValidTense(g.get('preterite', {}))
        && isValidTense(g.get('imperfect', {}))
        && isValidTense(g.get('conditional', {}))
        && isValidTense(g.get('future', {}));
    }

    function isValid_imperative(g) {
      return g is map && g.keys().hasOnly(['affirmative', 'negative'])
        && isValidTense(g.get('affirmative', {}))
        && isValidTense(g.get('negative', {}));
    }

    function isValid_progressive(g) {
      return g is map && g.keys().hasOnly(['gerund'])
        && isForm(g.get('gerund', ''));
    }

    function isValidConjugations(c) {
      return c is map && c.keys().hasOnly(['indicative', 'imperative', 'progressive'])
        && isValid_indicative(c.get('indicative', {}))
        && isValid_imperative(c.get('imperative', {}))
        && isValid_progressive(c.get('progressive', {}));
    }

    // Adjective forms – mirrors ADJECTIVE_KINDS in src/constants/adjective.ts.
    // { kind: 'four', feminine?, masculinePlural?, femininePlural? } or { kind: 'two', plural? }
    function isValidAdjective(a) {
      return a is map && (
        (a.get('kind', '') == 'four'
          && a.keys().hasOnly(['kind', 'feminine', 'masculinePlural', 'femininePlural'])
          && isForm(a.get('feminine', ''))
          && isForm(a.get('masculinePlural', ''))
          && isForm(a.get('femininePlural', '')))
        || (a.get('kind', '') == 'two'
          && a.keys().hasOnly(['kind', 'plural'])
          && isForm(a.get('plural', '')))
      );
    }

    // Optional fields may be absent ("not filled in") but must be valid when present.
    function isValidWord(data) {
      return isShortString(data.spanish, 300)
        && data.english is string && data.english.size() <= 300 // may be empty (drafts)
        && (!('type' in data) || data.type in wordTypes())
        && (!('article' in data) || data.article in articles())
        && (!('plural' in data) || (data.plural is string && data.plural.size() <= 300))
        && (!('conjugations' in data) || isValidConjugations(data.conjugations))
        && (!('adjective' in data) || isValidAdjective(data.adjective))
        && data.schemaVersion is int
        && data.easeFactor is number
        && data.interval is number
        && data.repetitions is int
        && data.nextReviewDate is int
        && data.createdAt is int;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /words/{wordId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidWord(request.resource.data);
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      match /dailyStats/{day} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything that is not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
